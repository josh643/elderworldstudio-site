<Page
    x:Class="ElderverseShell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#0A1224">
    <Grid x:Name="RootGrid" Background="#0A1224" SizeChanged="RootGrid_SizeChanged">
        <controls:WebView2 x:Name="WorldView" />
        <Grid x:Name="RecoveryPanel" Visibility="Collapsed" Background="#0A1224">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="Elderverse" FontSize="34" FontWeight="SemiBold"
                           Foreground="#F5F2EA" HorizontalAlignment="Center" />
                <TextBlock Text="Reconnecting…" FontSize="26" Foreground="#E3C978"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="RecoveryDetails" Text="The world is temporarily unavailable."
                           FontSize="22" Foreground="#D6DCE8" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="760" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
