{
  "name": "elderworldstudio-site",
  "private": true,
  "type": "module",
  "description": "Elder World Studio static site plus Elderverse worlds host",
  "scripts": {
    "worlds:lod": "node tools/worlds-lod-build.mjs",
    "worlds:assets": "node tools/worlds-build.mjs --assets",
    "worlds:build": "node tools/worlds-build.mjs",
    "worlds:host": "node incoming/world-server/ews-world-src/worlds-host.mjs",
    "test": "node --test packages/ews-render/test/*.test.mjs && playwright test",
    "test:render": "node --test packages/ews-render/test/*.test.mjs",
    "test:worlds": "playwright test tests/worlds"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "pngjs": "^7.0.0"
  }
}
