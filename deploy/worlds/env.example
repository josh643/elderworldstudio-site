# Copy to /etc/ews-worlds/env (root 600) or a local .env you export before worlds-host.
# Never commit real tokens.

PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
STATIC_ROOT=
# Absolute path to the site/ (or dist/worlds/) tree. Empty = repo site/ next to the host script.

EWS_WORLD_DATA=/var/lib/ews-worlds
# Moderator tokens only — no account names. Comma/space separated.
WORLD_MODERATORS=
# Optional: existing world-sim publish key (unused on a standalone host).
WORLD_KEY=
WORLDS_REPO=
