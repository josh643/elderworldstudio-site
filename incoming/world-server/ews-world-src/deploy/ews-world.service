[Unit]
Description=Elderverse world server (staging): town + construction + agent sim, outbound WS to the world DO
After=network-online.target ews-world-stub.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10
[Service]
Type=simple
User=ewsworld
Group=ewsworld
EnvironmentFile=/etc/ews-world/env
ExecStart=/usr/bin/node --max-old-space-size=384 /opt/ews-world/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=15
MemoryMax=768M
CPUQuota=150%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ews-world
SyslogIdentifier=ews-world
[Install]
WantedBy=multi-user.target
